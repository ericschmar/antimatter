MATTERMOST_SERVER_URL=https://mattermost.example.com
MATTERMOST_PAT=your-personal-access-token
GIPHY_API_KEY=your-giphy-api-key
# Debug builds only: prefill the email/password sign-in fields at launch. Copy to .env.local.
ANTIMATTER_DEV_SERVER=https://mattermost.example.com
ANTIMATTER_DEV_LOGIN=you@example.com
ANTIMATTER_DEV_PASSWORD=your-password
